NODE_ENV=development
API_PORT=4433
WEB_ORIGIN=http://localhost:3344
API_PUBLIC_URL=http://localhost:4433
# Web-only server-side upstream. Use the API service's private address in production.
API_BASE_URL=http://localhost:4433
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/devproof?schema=public
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/devproof_shadow?schema=public
REDIS_URL=redis://:devproof-local-redis@localhost:56379/0
OBJECT_STORAGE_ENDPOINT=http://localhost:59000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=devproof-artifacts
OBJECT_STORAGE_ACCESS_KEY=devproof-local-access
OBJECT_STORAGE_SECRET_KEY=devproof-local-secret-key
OBJECT_STORAGE_FORCE_PATH_STYLE=true
# Cloudflare R2 uses the same S3-compatible storage path. In production set:
# OBJECT_STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# OBJECT_STORAGE_REGION=auto
# OBJECT_STORAGE_BUCKET=<pre-created-r2-bucket>
# OBJECT_STORAGE_ACCESS_KEY=<r2-access-key-id>
# OBJECT_STORAGE_SECRET_KEY=<r2-secret-access-key>
# OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Feishu Web SSO. The tenant key check is the authoritative company boundary.
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=replace-me
FEISHU_ALLOWED_TENANT_KEY=replace-with-company-tenant-key
FEISHU_REDIRECT_URI=http://localhost:3344/auth/feishu/callback
# Optional Feishu group bot. Configure an encrypted event subscription callback at
# https://devproof.example.internal/integrations/feishu/events.
FEISHU_BOT_ENABLED=false
FEISHU_BOT_OPEN_ID=
FEISHU_EVENT_ENCRYPT_KEY=
FEISHU_EVENT_VERIFICATION_TOKEN=
FEISHU_NOTIFICATION_WEBHOOK_URL=
FEISHU_NOTIFICATION_WEBHOOK_SECRET=
# Optional signed callback used to wake an external Agent Runtime after HITL.
AGENT_RESUME_WEBHOOK_URL=
AGENT_RESUME_WEBHOOK_SECRET=
BACKGROUND_WORKERS_ENABLED=true
BACKGROUND_WORKER_POLL_MS=2000

# Structured logs, Prometheus scrape authentication and durable data lifecycle.
OBSERVABILITY_LOG_LEVEL=info
# Production requires a bearer token (minimum 32 characters) before /metrics is enabled.
OBSERVABILITY_METRICS_TOKEN=
TOOL_INVOCATION_STALE_SECONDS=1800
TOOL_INVOCATION_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
RUNTIME_DATA_RETENTION_DAYS=30

# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=replace-with-32-byte-base64-key
SESSION_TTL_HOURS=168

# Browser Runtime pairing instructions shown by the Console.
BROWSER_RUNTIME_API_URL=http://localhost:4433
RUNTIME_GATEWAY_WS_URL=ws://localhost:4433/runtime/connect
NEXT_PUBLIC_RUNTIME_API_URL=http://localhost:4433
RUNTIME_LEASE_SECONDS=45
RUNTIME_COMMAND_TIMEOUT_SECONDS=30
EXECUTION_WAIT_QUEUE_CAPACITY=100
# Browser Runtime process only: comma-separated exact host/IP or *.corp.example exceptions.
DEVPROOF_NETWORK_ALLOWLIST=

# Optional values for external MCP clients; DevProof services do not consume
# DEVPROOF_TOOL_TOKEN themselves.
DEVPROOF_MCP_URL=http://localhost:4433/mcp
DEVPROOF_TOOL_TOKEN=

# Internal Agent Runtime deployment identity; provision with:
# Provision one credential per pool; see the README for the three commands.
# Legacy member-issued Runtime tokens are revoked by the security migration.
# Agent Runtime is the only model/tool loop. Playground submits work to Run v2.
# Local `pnpm dev` starts one Agent Runtime process for each configured pool.
DEVPROOF_SPEC_ANALYSIS_RUNTIME_TOKEN=
DEVPROOF_BROWSER_EXECUTION_RUNTIME_TOKEN=
DEVPROOF_POST_RUN_ANALYSIS_RUNTIME_TOKEN=
# Recommended as an explicit assertion for standalone Agent Runtime deployments.
# If omitted, the Runtime binds to the pool carried by its pool-specific token.
# pnpm dev sets this from the corresponding token above.
DEVPROOF_AGENT_RUNTIME_POOL=
# Standalone Agent Runtime deployments continue to use this process-local name.
DEVPROOF_AGENT_RUNTIME_TOKEN=
DEVPROOF_API_URL=http://localhost:4433
DEVPROOF_AGENT_WORKER_ID=agent-runtime-local
DEVPROOF_AGENT_POLL_INTERVAL_MS=750
DEVPROOF_AGENT_TOOL_LIMIT=60
# Large immutable log bundles are read in bounded chunks with rolling context.
DEVPROOF_POST_RUN_ANALYSIS_TOOL_LIMIT=300
# Agent Runtime process only: exact hostnames/IPs for approved private or HTTP model gateways.
DEVPROOF_AGENT_MODEL_HOST_ALLOWLIST=

# Issue-first Spec generation. Linear is required for issueRef resolution;
# GitHub and Knowledge enrich the normalized source snapshot when configured.
# Prefer the official GraphQL API for stable assignee ids. PERSONAL_API_KEY sends
# the key as-is; OAUTH sends it as a Bearer token. MCP remains a fallback.
LINEAR_API_URL=https://api.linear.app/graphql
LINEAR_API_TOKEN=
LINEAR_API_AUTH_MODE=PERSONAL_API_KEY
LINEAR_WORKSPACE_ID=
LINEAR_MCP_URL=https://mcp.linear.app/mcp/readonly
LINEAR_MCP_BEARER_TOKEN=
LINEAR_MCP_TOOL=
LINEAR_MCP_TIMEOUT_MS=15000
# GitHub PATs are encrypted and managed per team in Console → Access.
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28
KNOWLEDGE_MCP_URL=
KNOWLEDGE_MCP_BEARER_TOKEN=
# Example for the local RAGFlow connector: ragflow_retrieval
KNOWLEDGE_MCP_TOOL=
KNOWLEDGE_MCP_STATIC_ARGUMENTS=
KNOWLEDGE_MCP_TIMEOUT_MS=15000
# AI Spec analysis. SHADOW uses the Agent Spec and records a comparison with the
# deterministic generator; DETERMINISTIC keeps legacy issue-spec-v1 for rollback.
SPEC_ANALYSIS_MODE=AGENT
POST_RUN_ANALYSIS_ENABLED=false
POST_RUN_ANALYSIS_ANALYZER_VERSION=post-run-analysis-v3
POST_RUN_ANALYSIS_CAPTURE_GRACE_SECONDS=30
POST_RUN_ANALYSIS_CONCURRENCY=3
POST_RUN_ANALYSIS_DEADLINE_SECONDS=21600
POST_RUN_ANALYSIS_HARD_DEADLINE_SECONDS=86400
POST_RUN_ANALYSIS_MAX_ATTEMPTS=3
POST_RUN_ANALYSIS_MIN_CONFIDENCE=0.7
POST_RUN_ANALYSIS_RECOVERY_LOOKBACK_HOURS=24
POST_RUN_ANALYSIS_RETRY_BACKOFF_SECONDS=30
