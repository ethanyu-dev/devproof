/// The v2 aggregate root shared by manual, CI, MCP, and agent-driven tests.
/// Browser resource lifecycle and product verdict deliberately remain separate.
model ExecutionRun {
  id                     String                @id @default(uuid()) @db.Uuid
  teamId                 String                @map("team_id") @db.Uuid
  taskExecutionId        String?               @map("task_execution_id") @db.Uuid
  browserProfileId       String?               @map("browser_profile_id") @db.Uuid
  sourceKind             String                @default("API") @map("source_kind")
  sourceId               String?               @map("source_id")
  idempotencyKey         String                @map("idempotency_key")
  goal                   String
  lifecycle              RunLifecycle          @default(QUEUED)
  executionDisposition   ExecutionDisposition? @map("execution_disposition")
  verdict                RunProductVerdict?
  criteriaSnapshot       Json                  @map("criteria_snapshot")
  environmentSnapshot    Json                  @default("{}") @map("environment_snapshot")
  executionPolicy        Json                  @default("{}") @map("execution_policy")
  currentAttemptNumber   Int                   @default(0) @map("current_attempt_number")
  maxAttempts            Int                   @default(3) @map("max_attempts")
  traceId                String                @map("trace_id") @db.VarChar(32)
  initialDeadlineAt      DateTime              @map("initial_deadline_at") @db.Timestamptz
  deadlineAt             DateTime              @map("deadline_at") @db.Timestamptz
  hardDeadlineAt         DateTime              @map("hard_deadline_at") @db.Timestamptz
  deadlineExtensionCount Int                   @default(0) @map("deadline_extension_count")
  deadlineExtendedMs     Int                   @default(0) @map("deadline_extended_ms")
  cancelRequestedAt      DateTime?             @map("cancel_requested_at") @db.Timestamptz
  queuedAt               DateTime              @default(now()) @map("queued_at") @db.Timestamptz
  startedAt              DateTime?             @map("started_at") @db.Timestamptz
  finishedAt             DateTime?             @map("finished_at") @db.Timestamptz
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz
  team                   Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  taskExecution          TaskExecution?        @relation(fields: [taskExecutionId], references: [id], onDelete: SetNull)
  browserProfile         UserBrowserProfile?   @relation(fields: [browserProfileId], references: [id], onDelete: SetNull)
  attempts               RunAttempt[]
  tasks                  AgentRuntimeTask[]
  events                 RunEvent[]
  evidences              RunEvidence[]
  criterionResults       RunCriterionResult[]
  interventions          HumanIntervention[]
  browserExecutions      BrowserExecution[]
  notificationOutbox     NotificationOutbox[]
  browserProfileUsages   BrowserProfileUsage[]
  generatedTestCase      GeneratedTestCase?    @relation("GeneratedCaseExecutionRun")
  taskCaseExecution      TaskCaseExecution?    @relation("TaskCaseExecutionRun")

  @@unique([teamId, idempotencyKey])
  @@index([teamId, lifecycle, createdAt(sort: Desc)])
  @@index([sourceKind, sourceId])
  @@index([taskExecutionId, lifecycle])
  @@index([browserProfileId, lifecycle], map: "execution_runs_browser_profile_lifecycle_idx")
  @@index([lifecycle, deadlineAt])
  @@map("execution_runs")
}

/// A user-visible execution request. Issue-driven tasks own two durable stages;
/// concrete browser verification remains in child ExecutionRun records.
model TaskExecution {
  id                        String                         @id @default(uuid()) @db.Uuid
  teamId                    String                         @map("team_id") @db.Uuid
  requestedByUserId         String?                        @map("requested_by_user_id") @db.Uuid
  requestedByKind           RequestActorKind               @default(CREDENTIAL) @map("requested_by_kind")
  kind                      TaskExecutionKind
  sourceKind                String                         @map("source_kind")
  sourceRef                 String?                        @map("source_ref")
  idempotencyKey            String                         @map("idempotency_key")
  title                     String
  lifecycle                 TaskExecutionLifecycle         @default(QUEUED)
  currentStage              TaskExecutionStageType         @default(SPEC_ANALYSIS) @map("current_stage")
  waitingReason             String?                        @map("waiting_reason")
  executionDisposition      ExecutionDisposition?          @map("execution_disposition")
  verdict                   RunProductVerdict?
  inputSnapshot             Json                           @map("input_snapshot")
  environmentSnapshot       Json                           @default("{}") @map("environment_snapshot")
  notificationContext       Json                           @default("{}") @map("notification_context")
  traceId                   String                         @map("trace_id") @db.VarChar(32)
  deadlineAt                DateTime                       @map("deadline_at") @db.Timestamptz
  cancelRequestedAt         DateTime?                      @map("cancel_requested_at") @db.Timestamptz
  projectionNeededAt        DateTime?                      @map("projection_needed_at") @db.Timestamptz
  projectedAt               DateTime?                      @map("projected_at") @db.Timestamptz
  legacySpecificationId     String?                        @map("legacy_specification_id") @db.Uuid
  migrationSource           String                         @default("NATIVE") @map("migration_source")
  sourceSnapshotComplete    Boolean                        @default(true) @map("source_snapshot_complete")
  queuedAt                  DateTime                       @default(now()) @map("queued_at") @db.Timestamptz
  startedAt                 DateTime?                      @map("started_at") @db.Timestamptz
  finishedAt                DateTime?                      @map("finished_at") @db.Timestamptz
  createdAt                 DateTime                       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime                       @updatedAt @map("updated_at") @db.Timestamptz
  team                      Team                           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  requestedBy               User?                          @relation("TaskExecutionRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  stages                    TaskExecutionStage[]
  specificationSnapshots    TaskSpecificationSnapshot[]
  caseExecutions            TaskCaseExecution[]
  deployments               TaskDeployment[]
  deploymentProfileBindings TaskDeploymentProfileBinding[]
  executionRuns             ExecutionRun[]
  events                    TaskExecutionEvent[]
  analysisSources           TaskAnalysisSource[]
  profileBinding            TaskProfileBinding?
  profileReservations       BrowserProfileReservation[]
  browserProfileUsages      BrowserProfileUsage[]
  inboundIntegrationEvents  InboundIntegrationEvent[]
  notifications             NotificationOutbox[]

  @@unique([teamId, idempotencyKey])
  @@index([teamId, lifecycle, createdAt(sort: Desc)])
  @@index([teamId, sourceKind, sourceRef])
  @@index([requestedByUserId, createdAt(sort: Desc)], map: "task_executions_requested_by_created_idx")
  @@index([projectionNeededAt])
  @@index([legacySpecificationId])
  @@map("task_executions")
}

/// An immutable test target within an Issue execution. Generated Specs are
/// fanned out across every enabled Deployment.
model TaskDeployment {
  id                  String                        @id @default(uuid()) @db.Uuid
  taskExecutionId     String                        @map("task_execution_id") @db.Uuid
  key                 String
  name                String
  targetUrl           String                        @map("target_url")
