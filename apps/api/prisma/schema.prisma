  enabled             Boolean                       @default(true)
  createdAt           DateTime                      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime                      @updatedAt @map("updated_at") @db.Timestamptz
  taskExecution       TaskExecution                 @relation(fields: [taskExecutionId], references: [id], onDelete: Cascade)
  caseExecutions      TaskCaseExecution[]
  profileBinding      TaskDeploymentProfileBinding?

  @@unique([taskExecutionId, key])
  @@unique([id, taskExecutionId])
  @@index([taskExecutionId, enabled, createdAt])
  @@map("task_deployments")
}

/// Resolves a persistent Browser Profile independently for every Deployment.
/// This allows one Issue to target domains routed to different Browser nodes.
model TaskDeploymentProfileBinding {
  id              String             @id @default(uuid()) @db.Uuid
  teamId          String             @map("team_id") @db.Uuid
  taskExecutionId String             @map("task_execution_id") @db.Uuid
  deploymentId    String             @map("deployment_id") @db.Uuid
  profileId       String             @map("profile_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  team            Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  taskExecution   TaskExecution      @relation(fields: [taskExecutionId], references: [id], onDelete: Cascade)
  deployment      TaskDeployment     @relation(fields: [deploymentId, taskExecutionId], references: [id, taskExecutionId], onDelete: Cascade, map: "task_deployment_profile_bindings_deployment_fkey")
  profile         UserBrowserProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)

  @@unique([deploymentId, taskExecutionId], map: "task_deployment_profile_bindings_deployment_task_key")
  @@index([profileId, taskExecutionId], map: "task_deployment_profile_bindings_profile_task_idx")
  @@index([teamId, taskExecutionId], map: "task_deployment_profile_bindings_team_task_idx")
  @@map("task_deployment_profile_bindings")
}

