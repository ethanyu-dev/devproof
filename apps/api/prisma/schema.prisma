generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum TeamRole {
  MEMBER
  ADMIN
}

enum IdentityProvider {
  FEISHU
}

enum RuntimeStatus {
  ONLINE
  OFFLINE
  REVOKED
}

enum AgentRuntimePool {
  SPEC_ANALYSIS
  BROWSER_EXECUTION
  MIXED
}

enum RuntimeRoutingFallbackPolicy {
  WAIT
  FAIL_FAST
}

enum RuntimeSessionStatus {
  OPENING
  ACTIVE
  HUMAN_CONTROL
  CLOSING
  CLOSED
  FAILED
  LOST
}

enum RuntimeCommandStatus {
  PENDING
  DISPATCHED
  SUCCEEDED
  FAILED
  CANCELLED
  TIMED_OUT
}

enum RuntimeCommandSource {
  SYSTEM
  AGENT
  CONSOLE
  HUMAN
}

enum BrowserProfileMode {
  PERSISTENT
  EPHEMERAL
}

enum BrowserRuntimeSessionPurpose {
  EXECUTION
  PROFILE_PREPARATION
  PROFILE_VERIFICATION
  PROFILE_PURGE
}

enum ExternalIdentityProvider {
  FEISHU_OPEN_ID
  FEISHU_UNION_ID
  FEISHU_USER_ID
  LINEAR
}

enum UserBrowserProfileStatus {
  UNINITIALIZED
  PREPARING
  READY
  REAUTH_REQUIRED
  MIGRATION_REQUIRED
  LOST
  DISABLED
}

enum BrowserProfileTriggerSource {
  CONSOLE
  FEISHU
  ISSUE_ASSIGNEE
}

enum TaskProfileStrategy {
  EPHEMERAL
  REQUESTER
  ISSUE_ASSIGNEE
  EXPLICIT_PROFILE
}

enum TaskProfileResolutionStatus {
  PENDING
  RESOLVED
  WAITING_INPUT
  REJECTED
}

enum ProfileUnavailablePolicy {
  WAIT_FOR_PROFILE
  FAIL
  USE_EPHEMERAL
}

enum BrowserProfileReservationStatus {
  QUEUED
  ACTIVE
  RELEASED
  CANCELLED
  EXPIRED
}

enum RequestActorKind {
  USER
  CREDENTIAL
  INTEGRATION_EVENT
  SYSTEM
}

enum IntegrationProvider {
  FEISHU
  LINEAR
}

enum IntegrationEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  IGNORED
  FAILED
}

enum RuntimeArtifactKind {
  SCREENSHOT
  DOM
  CONSOLE
  NETWORK
  VIDEO
}

enum TestProjectStatus {
  ACTIVE
  ARCHIVED
}

enum TestCaseStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum TestRunStatus {
  QUEUED
  RUNNING
  WAITING_HUMAN
  PASSED
  FAILED
  CANCELLED
  TIMED_OUT
}

enum TestRunTrigger {
  MANUAL
  CI
  REPLAY
}

enum TestTraceActor {
  SYSTEM
  BROWSER
  HUMAN
}

enum TestTraceStatus {
  STARTED
  SUCCEEDED
  FAILED
  SKIPPED
}

enum TestRunCheckpointStatus {
  PENDING
  RESOLVED
  EXPIRED
  CANCELLED
}

enum AgentRuntimeProvider {
  OPENAI
  CODEX
  CLAUDE
  CUSTOM
  GENERIC
}

enum VerificationRunStatus {
  QUEUED
  WAITING_EXECUTION
  RUNNING
  WAITING_HUMAN
  PASSED
  FAILED
  INCONCLUSIVE
  CANCELLED
  TIMED_OUT
}

enum VerificationEventActor {
  SYSTEM
  AGENT
  RUNNER
  HUMAN
  WORKER
}

enum VerificationCheckpointStatus {
  PENDING
  RESOLVED
  EXPIRED
  CANCELLED
}

enum VerificationAssertionStatus {
  PASSED
  FAILED
  INCONCLUSIVE
}

enum NotificationChannel {
  FEISHU
  AGENT_WEBHOOK
  GITHUB
}

enum NotificationOutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
  CANCELLED
}

enum ToolInvocationStatus {
  STARTED
  SUCCEEDED
  FAILED
  CANCELLED
  TIMED_OUT
}

enum VerificationTraceStatus {
  INFO
  STARTED
  SUCCEEDED
  FAILED
  CANCELLED
  TIMED_OUT
}

enum RunLifecycle {
  QUEUED
  PREPARING
  RUNNING
  WAITING_HUMAN
  COMPLETED
  CANCELLED
  TIMED_OUT
}

enum ExecutionDisposition {
  EXECUTED
  NOT_RUN
  BLOCKED
  AGENT_ERROR
  PROVIDER_ERROR
  BROWSER_UNAVAILABLE
  RUNTIME_LOST
}

enum RunProductVerdict {
  PASSED
  FAILED
  INCONCLUSIVE
}

enum RunAttemptStatus {
  PENDING
  RUNNING
  WAITING_HUMAN
  SUCCEEDED
  FAILED
  CANCELLED
  TIMED_OUT
}

enum AgentRuntimeTaskStatus {
  PENDING
  RUNNING
  WAITING_HUMAN
  SUCCEEDED
  FAILED
  CANCELLED
  TIMED_OUT
}

enum BrowserExecutionStatus {
  REQUESTED
  WAITING_CAPACITY
  ALLOCATING
  ACTIVE
  HUMAN_CONTROL
  RELEASING
  RELEASED
  FAILED
  LOST
  TIMED_OUT
}

enum RunInterventionStatus {
  PENDING
  RESOLVED
  EXPIRED
  CANCELLED
}

enum SpecificationTargetSource {
  GITHUB
  MANUAL
}

enum TaskExecutionKind {
  ISSUE_SPEC
  DIRECT_RUN
  LEGACY_RUN
}

enum TaskExecutionLifecycle {
  QUEUED
  RUNNING
  WAITING_INPUT
  WAITING_HUMAN
  COMPLETED
  CANCELLED
  TIMED_OUT
}

enum TaskExecutionStageType {
  SPEC_ANALYSIS
  PROFILE_RESOLUTION
  SPEC_EXECUTION
}

enum TaskExecutionStageStatus {
  PENDING
  RUNNING
  WAITING_INPUT
  SUCCEEDED
  FAILED
  CANCELLED
  SKIPPED
}

enum TaskStageAttemptStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  TIMED_OUT
}

enum TaskCaseDispatchStatus {
  PENDING
  DISPATCHING
  LINKED
  FAILED
  CANCELLED
}

model User {
  id                              String                     @id @default(uuid()) @db.Uuid
  name                            String?
  email                           String?
  avatarUrl                       String?                    @map("avatar_url")
  status                          UserStatus                 @default(ACTIVE)
  createdAt                       DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                       DateTime                   @updatedAt @map("updated_at") @db.Timestamptz
  identities                      AuthIdentity[]
  sessions                        Session[]
  memberships                     TeamMembership[]
  auditEvents                     AuditEvent[]
  controlledRuntimeSessions       BrowserRuntimeSession[]    @relation("RuntimeSessionHumanController")
  createdTestCaseVersions         TestCaseVersion[]          @relation("TestCaseVersionCreator")
  requestedTestRuns               TestRun[]                  @relation("TestRunRequester")
  resolvedTestCheckpoints         TestRunHumanCheckpoint[]   @relation("TestRunCheckpointResolver")
  createdToolCredentials          ToolCredential[]           @relation("ToolCredentialCreator")
  resolvedVerificationCheckpoints VerificationCheckpoint[]   @relation("VerificationCheckpointResolver")
  browserHumanControlLeases       BrowserHumanControlLease[] @relation("BrowserHumanControlLeaseController")
  externalIdentities              UserExternalIdentity[]
  ownedBrowserProfiles            UserBrowserProfile[]       @relation("BrowserProfileOwner")
  consentedBrowserProfileGrants   BrowserProfileGrant[]      @relation("BrowserProfileGrantConsenter")
  requestedTaskExecutions         TaskExecution[]            @relation("TaskExecutionRequester")
  githubAccessCredentials         GithubAccessCredential[]
  agentModelConfigurations        AgentModelConfiguration[]
  profileBindingOwnerships        TaskProfileBinding[]       @relation("TaskProfileBindingOwner")
  browserProfileUsages            BrowserProfileUsage[]      @relation("BrowserProfileUsageRequester")

  @@map("users")
}

model AuthIdentity {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  provider       IdentityProvider
  providerUserId String           @map("provider_user_id")
  tenantKey      String           @map("tenant_key")
  rawProfile     Json             @default("{}") @map("raw_profile")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([tenantKey])
  @@map("auth_identities")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model Team {
  id                            String                         @id @default(uuid()) @db.Uuid
  slug                          String                         @unique
  name                          String
  feishuTenantKey               String                         @unique @map("feishu_tenant_key")
  createdAt                     DateTime                       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                     DateTime                       @updatedAt @map("updated_at") @db.Timestamptz
  memberships                   TeamMembership[]
  runtimeSettings               RuntimeSettings?
  githubAccessCredentials       GithubAccessCredential[]
  agentRuntimeCredentials       AgentRuntimeCredential[]
  agentModelConfigurations      AgentModelConfiguration[]
  browserRuntimes               BrowserRuntime[]
  runtimeProfileLeases          BrowserRuntimeProfileLease[]
  runtimeRoutingRules           RuntimeRoutingRule[]
  pairingTokens                 BrowserRuntimePairingToken[]
  runtimeSessions               BrowserRuntimeSession[]
  testProjects                  TestProject[]
  testEnvironments              TestEnvironment[]
  testCases                     TestCase[]
  testCaseVersions              TestCaseVersion[]
  testRuns                      TestRun[]
  testTraceEvents               TestRunTraceEvent[]
  testRunArtifacts              TestRunArtifact[]
  testRunCheckpoints            TestRunHumanCheckpoint[]
  toolCredentials               ToolCredential[]
  verificationRuns              VerificationRun[]
  verificationEvents            VerificationEvent[]
  verificationArtifacts         VerificationArtifact[]
  verificationCheckpoints       VerificationCheckpoint[]
  verificationAssertions        VerificationAssertion[]
  notificationOutbox            NotificationOutbox[]
  browserHumanControlLeases     BrowserHumanControlLease[]
  auditEvents                   AuditEvent[]
  toolInvocations               ToolInvocation[]
  executionRuns                 ExecutionRun[]
  runEvents                     RunEvent[]
  runEvidences                  RunEvidence[]
  runCriterionResults           RunCriterionResult[]
  runInterventions              HumanIntervention[]
  testSpecifications            TestSpecification[]
  generatedTestCases            GeneratedTestCase[]
  taskExecutions                TaskExecution[]
  taskExecutionEvents           TaskExecutionEvent[]
  taskAnalysisSources           TaskAnalysisSource[]
  externalIdentities            UserExternalIdentity[]
  userBrowserProfiles           UserBrowserProfile[]
  browserProfileGrants          BrowserProfileGrant[]
  browserProfileReservations    BrowserProfileReservation[]
  browserProfileUsages          BrowserProfileUsage[]
  taskDeploymentProfileBindings TaskDeploymentProfileBinding[]
  inboundIntegrationEvents      InboundIntegrationEvent[]

  @@map("teams")
}

model TeamMembership {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_memberships")
}

model ToolCredential {
  id                 String              @id @default(uuid()) @db.Uuid
  teamId             String              @map("team_id") @db.Uuid
  name               String
  tokenHash          String              @unique @map("token_hash")
  tokenHint          String              @map("token_hint")
  scopes             String[]            @default([])
  expiresAt          DateTime?           @map("expires_at") @db.Timestamptz
  lastUsedAt         DateTime?           @map("last_used_at") @db.Timestamptz
  revokedAt          DateTime?           @map("revoked_at") @db.Timestamptz
  createdByUserId    String              @map("created_by_user_id") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  team               Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy          User                @relation("ToolCredentialCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  verificationRuns   VerificationRun[]
  verificationEvents VerificationEvent[]
  toolInvocations    ToolInvocation[]

  @@unique([teamId, name])
  @@index([teamId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("tool_credentials")
}

model GithubAccessCredential {
  id                 String   @id @default(uuid()) @db.Uuid
  teamId             String   @map("team_id") @db.Uuid
  name               String
  tokenEncrypted     String   @map("token_encrypted")
  tokenHint          String   @map("token_hint")
  organizations      String[] @default([])
  repositories       String[] @default([])
  priority           Int      @default(100)
  enabled            Boolean  @default(true)
  configuredByUserId String   @map("configured_by_user_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz
  team               Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  configuredBy       User     @relation(fields: [configuredByUserId], references: [id], onDelete: Restrict)

  @@unique([teamId, name])
  @@index([teamId, enabled, priority(sort: Desc)])
  @@map("github_access_credentials")
}

model AgentRuntimeCredential {
  id         String           @id @default(uuid()) @db.Uuid
  teamId     String           @map("team_id") @db.Uuid
  name       String
  tokenHash  String           @unique @map("token_hash")
  tokenHint  String           @map("token_hint")
  pool       AgentRuntimePool
  expiresAt  DateTime?        @map("expires_at") @db.Timestamptz
  lastUsedAt DateTime?        @map("last_used_at") @db.Timestamptz
  revokedAt  DateTime?        @map("revoked_at") @db.Timestamptz
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  team       Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, name])
  @@index([teamId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("agent_runtime_credentials")
}

model AgentModelConfiguration {
  id                 String   @id @default(uuid()) @db.Uuid
  teamId             String   @map("team_id") @db.Uuid
  baseUrl            String   @map("base_url")
  apiKeyEncrypted    String   @map("api_key_encrypted")
  apiKeyHint         String   @map("api_key_hint")
  modelId            String   @map("model_id")
  displayName        String   @map("display_name")
  position           Int
  configuredByUserId String   @map("configured_by_user_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz
  team               Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  configuredBy       User     @relation(fields: [configuredByUserId], references: [id], onDelete: Restrict)

  @@unique([teamId, displayName])
  @@index([teamId, position])
  @@map("agent_model_configurations")
}

model RuntimeSettings {
  id          String   @id @default(uuid()) @db.Uuid
  teamId      String   @unique @map("team_id") @db.Uuid
  hitlEnabled Boolean  @default(true) @map("hitl_enabled")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("runtime_settings")
}

model BrowserRuntime {
  id                   String                       @id @default(uuid()) @db.Uuid
  teamId               String                       @map("team_id") @db.Uuid
  instanceKey          String                       @map("instance_key")
  name                 String
  version              String                       @default("")
  deviceInfo           String                       @default("") @map("device_info")
  status               RuntimeStatus                @default(OFFLINE)
  capabilities         Json                         @default("[]")
  maxConcurrency       Int                          @default(1) @map("max_concurrency")
  networkAllowlist     String[]                     @default([]) @map("network_allowlist")
  tokenHash            String                       @unique @map("token_hash")
  tokenHint            String                       @map("token_hint")
  protocolMajor        Int?                         @map("protocol_major")
  protocolMinor        Int?                         @map("protocol_minor")
  gatewayInstanceId    String?                      @map("gateway_instance_id")
  enabled              Boolean                      @default(true)
  lastSeenAt           DateTime?                    @map("last_seen_at") @db.Timestamptz
  connectedAt          DateTime?                    @map("connected_at") @db.Timestamptz
  revokedAt            DateTime?                    @map("revoked_at") @db.Timestamptz
  createdAt            DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                     @updatedAt @map("updated_at") @db.Timestamptz
  team                 Team                         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sessions             BrowserRuntimeSession[]
  slots                BrowserRuntimeSlot[]
  fenceCounter         BrowserRuntimeFenceCounter?
  profileLeases        BrowserRuntimeProfileLease[]
  routingRules         RuntimeRoutingRule[]
  assignedUserProfiles UserBrowserProfile[]

  @@unique([teamId, instanceKey])
  @@index([teamId, updatedAt(sort: Desc)])
  @@index([status, lastSeenAt])
  @@map("browser_runtimes")
}

model RuntimeRoutingRule {
  id              String                       @id @default(uuid()) @db.Uuid
  teamId          String                       @map("team_id") @db.Uuid
  hostnamePattern String                       @map("hostname_pattern")
  runtimeId       String                       @map("runtime_id") @db.Uuid
  priority        Int                          @default(100)
  fallbackPolicy  RuntimeRoutingFallbackPolicy @default(WAIT) @map("fallback_policy")
  enabled         Boolean                      @default(true)
  createdAt       DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime                     @updatedAt @map("updated_at") @db.Timestamptz
  team            Team                         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  runtime         BrowserRuntime               @relation(fields: [runtimeId], references: [id], onDelete: Cascade)

  @@unique([teamId, hostnamePattern])
  @@index([teamId, enabled, priority(sort: Desc)])
  @@index([runtimeId])
  @@map("runtime_routing_rules")
}

model BrowserRuntimeSession {
  id                    String                       @id @default(uuid()) @db.Uuid
  teamId                String                       @map("team_id") @db.Uuid
  runtimeId             String                       @map("runtime_id") @db.Uuid
  status                RuntimeSessionStatus         @default(OPENING)
  profileMode           BrowserProfileMode           @map("profile_mode")
  profileKey            String                       @map("profile_key")
  userBrowserProfileId  String?                      @map("user_browser_profile_id") @db.Uuid
  purpose               BrowserRuntimeSessionPurpose @default(EXECUTION)
  slotNumber            Int                          @map("slot_number")
  leaseToken            String                       @map("lease_token") @db.Uuid
  fencingToken          BigInt                       @map("fencing_token")
  leaseExpiresAt        DateTime                     @map("lease_expires_at") @db.Timestamptz
  protocolMajor         Int                          @map("protocol_major")
  protocolMinor         Int                          @map("protocol_minor")
  humanControllerUserId String?                      @map("human_controller_user_id") @db.Uuid
  humanControlExpiresAt DateTime?                    @map("human_control_expires_at") @db.Timestamptz
  lastError             Json?                        @map("last_error")
  openedAt              DateTime?                    @map("opened_at") @db.Timestamptz
  closedAt              DateTime?                    @map("closed_at") @db.Timestamptz
  createdAt             DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime                     @updatedAt @map("updated_at") @db.Timestamptz
  team                  Team                         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  runtime               BrowserRuntime               @relation(fields: [runtimeId], references: [id], onDelete: Restrict)
  humanController       User?                        @relation("RuntimeSessionHumanController", fields: [humanControllerUserId], references: [id], onDelete: SetNull)
  slot                  BrowserRuntimeSlot?
  profileLease          BrowserRuntimeProfileLease?
  commands              BrowserRuntimeCommand[]
  artifacts             BrowserRuntimeArtifact[]
  events                BrowserRuntimeEvent[]
  testRuns              TestRun[]
  verificationRuns      VerificationRun[]
  humanControlLease     BrowserHumanControlLease?
  browserExecutions     BrowserExecution[]
  userBrowserProfile    UserBrowserProfile?          @relation(fields: [userBrowserProfileId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt(sort: Desc)])
  @@index([runtimeId, status])
  @@index([leaseExpiresAt])
  @@index([userBrowserProfileId, status], map: "browser_runtime_sessions_user_profile_status_idx")
  @@map("browser_runtime_sessions")
}

model BrowserRuntimeSlot {
  id           String                @id @default(uuid()) @db.Uuid
  runtimeId    String                @map("runtime_id") @db.Uuid
  sessionId    String                @unique @map("session_id") @db.Uuid
  slotNumber   Int                   @map("slot_number")
  leaseToken   String                @map("lease_token") @db.Uuid
  fencingToken BigInt                @map("fencing_token")
  expiresAt    DateTime              @map("expires_at") @db.Timestamptz
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz
  runtime      BrowserRuntime        @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  session      BrowserRuntimeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([runtimeId, slotNumber])
  @@index([expiresAt])
  @@map("browser_runtime_slots")
}

model BrowserRuntimeFenceCounter {
  runtimeId String         @id @map("runtime_id") @db.Uuid
  value     BigInt         @default(0)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  runtime   BrowserRuntime @relation(fields: [runtimeId], references: [id], onDelete: Cascade)

  @@map("browser_runtime_fence_counters")
}

model BrowserRuntimeProfileLease {
  id           String                @id @default(uuid()) @db.Uuid
  teamId       String                @map("team_id") @db.Uuid
  runtimeId    String                @map("runtime_id") @db.Uuid
  sessionId    String                @unique @map("session_id") @db.Uuid
  profileKey   String                @map("profile_key")
  leaseToken   String                @map("lease_token") @db.Uuid
  fencingToken BigInt                @map("fencing_token")
  expiresAt    DateTime              @map("expires_at") @db.Timestamptz
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz
  team         Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  runtime      BrowserRuntime        @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  session      BrowserRuntimeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([teamId, profileKey])
  @@index([runtimeId, profileKey])
  @@index([expiresAt])
  @@map("browser_runtime_profile_leases")
}

model BrowserRuntimeCommand {
  id           String                   @id @default(uuid()) @db.Uuid
  sessionId    String                   @map("session_id") @db.Uuid
  commandType  String                   @map("command_type")
  source       RuntimeCommandSource     @default(CONSOLE)
  status       RuntimeCommandStatus     @default(PENDING)
  payload      Json                     @default("{}")
  result       Json?
  error        Json?
  leaseToken   String                   @map("lease_token") @db.Uuid
  fencingToken BigInt                   @map("fencing_token")
  deadlineAt   DateTime                 @map("deadline_at") @db.Timestamptz
  dispatchedAt DateTime?                @map("dispatched_at") @db.Timestamptz
  completedAt  DateTime?                @map("completed_at") @db.Timestamptz
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime                 @updatedAt @map("updated_at") @db.Timestamptz
  session      BrowserRuntimeSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  artifacts    BrowserRuntimeArtifact[]

  @@index([sessionId, createdAt])
  @@index([status, deadlineAt])
  @@map("browser_runtime_commands")
}

model BrowserRuntimeArtifact {
  id                    String                 @id @default(uuid()) @db.Uuid
  sessionId             String                 @map("session_id") @db.Uuid
  commandId             String?                @map("command_id") @db.Uuid
  kind                  RuntimeArtifactKind
  storageKey            String                 @unique @map("storage_key")
  contentType           String                 @map("content_type")
  byteSize              Int                    @map("byte_size")
  sha256                String
